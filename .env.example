# ---------------------------------------------------------------------------
# Nutri Vision - App do paciente (Flutter)
# Copie para `.env` antes do primeiro build. `.env` NAO vai pro git.
# Lido em runtime por flutter_dotenv (declarado como asset no pubspec.yaml).
# ---------------------------------------------------------------------------

# URL base da API do back-end.
# Emulador Android: use 10.0.2.2 em vez de localhost.
API_URL=http://10.0.2.2:8000/api/v1

# Nome exibido no app
APP_NAME=Nutri Vision

# Ambiente (development | staging | production)
ENVIRONMENT=development

# Paciente usado no historico enquanto nao existe login (Task 1.2).
PACIENTE_ID=1

# Meta diaria de calorias da barra de progresso, ate o plano vir da API.
META_KCAL_DIARIA=2000

# Push dos lembretes de refeicao via Firebase Cloud Messaging (Task 2.8, RF26).
# Valores do app Android no Firebase (o mesmo projeto do FCM_CREDENTIALS_FILE do
# back-end) - veja "Lembretes de refeicao" no README. Preencha as 4 ou deixe as
# 4 vazias: vazias, o app roda normalmente, so sem push.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
